# --- AI (required for the AI chat experience) ---------------------------------
# Free Google Gemini API key from https://aistudio.google.com/apikey
# Without it, the app still runs but falls back to a simple keyword search
# instead of the natural-language AI path.
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-2.5-flash (fast + free tier).
# GEMINI_MODEL=gemini-2.5-flash

# --- Database (optional) ------------------------------------------------------
# Attach Vercel Postgres / Neon and these are set for you in the Vercel dashboard.
# Locally, `vercel env pull .env.local` pulls them in. If unset, the app uses the
# bundled sample dataset in data/happy-hours.json.
# POSTGRES_URL=
