# --- AI (required for the AI chat experience) ---------------------------------
# Get a key at https://console.anthropic.com. Without it, the app still runs but
# falls back to a simple keyword search instead of the natural-language AI path.
ANTHROPIC_API_KEY=

# Optional: override the model. Defaults to claude-sonnet-5 (fast + inexpensive,
# good for this tool-calling workload). Use claude-opus-5 for max quality.
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Database (optional) ------------------------------------------------------
# Attach Vercel Postgres / Neon and these are set for you in the Vercel dashboard.
# Locally, `vercel env pull .env.local` pulls them in. If unset, the app uses the
# bundled sample dataset in data/happy-hours.json.
# POSTGRES_URL=
